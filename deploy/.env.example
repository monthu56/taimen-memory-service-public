# memory-service — конфигурация изолированного инстанса (один заказчик = один контур).
# Скопируйте в .env рядом с docker-compose.yml и заполните. Файл .env в git не попадает.

# --- PostgreSQL (внутренний, только для этого инстанса) ---
POSTGRES_USER=memory
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=company_brain

# --- Доступ потребителей к Memory API ---
# Сгенерируйте: openssl rand -hex 32
CB_SERVER_API_KEY=CHANGE_ME_API_TOKEN
# Токены с полным допуском к ПДн (через запятую); пусто — только маскированная выдача.
CB_SERVER_API_KEYS_PII=
CB_PII_PROTECTION=true
# Опционально: реестр ключей с грантами по префиксу namespace (ADR-017), JSON-массив.
# Legacy-ключи выше остаются full-access; ключи реестра видят только свои базы знаний.
# CB_API_KEYS='[{"name":"bank-bot","key":"…","grants":[{"prefix":"bank","read":true,"write":true}]}]'
CB_API_KEYS=

# --- Access token IAM платформы (ADR-018) — второй способ рядом с ключами выше ---
# Включать только в контуре с IAM: Bearer-JWT на audience memory-service проверяется по
# JWKS (подпись, точные issuer/audience, срок). Токен видит базы tenant:<tenant_id>*
# (плюс claim memory_namespaces); scopes memory:read / memory:write / memory:pii.
CB_IAM_ENABLED=false
# Точный `iss` токена, как его выпускает IAM (публичный адрес issuer).
CB_IAM_ISSUER=
# JWKS IAM — внутренний адрес (не через внешний прокси и не свой TLS).
CB_IAM_JWKS_URL=
CB_IAM_AUDIENCE=memory-service
CB_IAM_LEEWAY_SECONDS=5

# База знаний по умолчанию (запросы без scope работают в ней).
CB_DEFAULT_NAMESPACE=main

# --- Эмбеддинги и LLM ---
# Для оффлайн-прогона/приёмки: fake + echo (внешние ключи не нужны).
# Для прода: openai-совместимый endpoint + ключи.
CB_EMBEDDING_PROVIDER=fake
CB_EMBEDDING_BASE_URL=
CB_EMBEDDING_API_KEY=
CB_EMBEDDING_MODEL=text-embedding-3-small
CB_LLM_PROVIDER=echo
CB_LLM_BASE_URL=
CB_LLM_API_KEY=

# --- Memory Console (админ-интерфейс /console) ---
# Включать ТОЛЬКО когда /console закрыт reverse proxy с аутентификацией (RUNBOOK.md).
CB_CONSOLE_ENABLED=false
# Базы знаний, доступные в Console (CSV), например: bank,mos-card
CB_CONSOLE_NAMESPACES=

# Порт сервиса на loopback хоста (за proxy).
MEMORY_SERVICE_PORT=8077

# --- Опциональная публикация через Traefik ---
# Нужны ТОЛЬКО вместе с docker-compose.traefik.yml. Сеть должна существовать,
# а host уже иметь валидный TLS-сертификат в используемом Traefik.
TRAEFIK_NETWORK=proxy_default
CB_PUBLIC_HOST=memory.example.com
CB_PUBLIC_PATH_PREFIX=/memory

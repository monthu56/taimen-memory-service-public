# Демо-витрина — переменные окружения (пример). Секретов здесь НЕТ.
# Скопируйте в .env рядом (он в .gitignore) и заполните на своём контуре.

# --- seed_stand.py: загрузка синтетического корпуса в демо-KB стенда ---
DEMO_BASE_URL=https://your-host.example        # базовый URL memory-service
DEMO_TOKEN=                                     # Bearer-токен сервиса (если включён auth)
DEMO_NAMESPACE=demo                             # namespace демо-KB

# --- CB_DEMO_* читает сам memory-service (см. teststand/memory-demo/.env на стенде) ---
# CB_DEMO_PUBLIC_ENABLED=true                   # включить витрину (по умолчанию false)
# CB_DEMO_NAMESPACE=demo                        # единственная KB витрины
# CB_DEMO_RATE_LIMIT=30                         # запросов/мин с одного IP (0 = без лимита)
# CB_DEMO_BRAND_NAME=Verifiable Memory          # нейтрально по умолчанию
# CB_DEMO_BRAND_TAGLINE=Answers your team can trace back to the source.
# CB_DEMO_CTA_URL=mailto:hello@your-domain.example
# CB_DEMO_DOMAIN=your-domain.example
